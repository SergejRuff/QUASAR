ref = sc_d_f,
ct_name = 'cell_type',
bootstrap = FALSE,
patient_id_column = 'sample_id',
n_bulk_samples = 1000,
cells_per_bulk = 100,adjust_ref = FALSE)
colnames(test_d$cell_proportions) <- rownames(bulk$ground_truth_proportions)
quas_d_met = quasar_prop_metrics(estimated_proportions = t(test_d$cell_proportions),ground_truth_proportions = bulk$ground_truth_proportions)
quas_d_met$pearson_celltype_cor
