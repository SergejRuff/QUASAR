library(Seurat)
library(SingleCellExperiment)
if(.Platform$OS.type == "unix"){
os_prefix <- "/home/ag_bioinf/"
}else{
os_prefix <- "G:/tiergenomik/AG_bioinf/"
}
# Source helper functions
quasar <- list.files(paste0(os_prefix,"research/Ruff_Sergej/13_QUASAR/analysis/code/quasar/R"), full.names = TRUE)
lapply(quasar, source)
den_gt = paste0(os_prefix,"research/Ruff_Sergej/10_compare_deconvolution_methods/analysis/data_derived/mild dengue/pseudo_bulk")
sel_gene_col_den <- paste0(os_prefix,'research/Ruff_Sergej/10_compare_deconvolution_methods/analysis/data_derived/mild dengue/genes_for_quasar/dengue_1000_genes_for_quasar.RDS')
den_train <- paste0(os_prefix,'research/Ruff_Sergej/10_compare_deconvolution_methods/analysis/data_derived/mild dengue/split/train_mild dengue.RDS')
bulk = readRDS(list.files(den_gt,full.names = TRUE)[[1]])
sel_gen = readRDS(sel_gene_col_den)
sc_d = readRDS(den_train)
sc_d_f = sc_d[sel_gen$genes,]
test_d = quasar(bulk$bulk_expression_profiles_sum,
ref = sc_d_f,
ct_name = 'cell_type',
bootstrap = FALSE,
patient_id_column = 'sample_id',
n_bulk_samples = 1000,
cells_per_bulk = 100,adjust_ref = FALSE)
colnames(test_d$cell_proportions) <- rownames(bulk$ground_truth_proportions)
quas_d_met = quasar_prop_metrics(estimated_proportions = t(test_d$cell_proportions),ground_truth_proportions = bulk$ground_truth_proportions)
quas_d_met$pearson_celltype_cor
mus_prop = MuSiC::music_prop(bulk$bulk_expression_profiles_sum,as.SingleCellExperiment(sc_d),clusters = 'cell_type',samples = 'sample_id')
rownames(mus_prop$Est.prop.weighted)
rownames(mus_prop$Est.prop.weighted) <- colnames(bulk$ground_truth_proportions)
rownames(mus_prop$Est.prop.weighted) <- rownames(bulk$ground_truth_proportions)
quas_d_met_music = quasar_prop_metrics(estimated_proportions = mus_prop$Est.prop.weighted,ground_truth_proportions = bulk$ground_truth_proportions)
cbind(quas_d_met$pearson_celltype_cor,quas_d_met_music$pearson_celltype_cor)
quas_d_met$pearson_celltype_cor[order(quas_d_met$pearson_celltype_cor)]
