quasar_sim_bulk <- function(...,
n_bulk_samples,
cells_per_bulk,
aggregation = c("average", "sum", "both"),  # default average
expr_var = NULL,
cell_type_column = "cell_type",
patient_id_column = NULL,
select_ct = NULL,
add_perc_background = 0,
seet = 1,
return_used_samples = FALSE,
return_patient_metadata = FALSE,
verbose = FALSE) {
aggregation <- match.arg(aggregation)  # validate against allowed options
args <- list(...)
# ==== Input handling ====
if (length(args) == 1) {
obj <- args[[1]]
if (inherits(obj, "Seurat")) {
count_matrix <- Seurat::GetAssayData(obj, slot = "counts")
cell_metadata <- obj@meta.data
} else if (inherits(obj, "SingleCellExperiment")) {
count_matrix <- SingleCellExperiment::counts(obj)
cell_metadata <- as.data.frame(SummarizedExperiment::colData(obj))
} else stop("Single input must be Seurat or SCE object")
} else if (length(args) == 2) {
count_matrix <- args[[1]]
cell_metadata <- as.data.frame(args[[2]])
common_cells <- intersect(colnames(count_matrix), rownames(cell_metadata))
if (length(common_cells) == 0) stop("No matching cells")
count_matrix <- count_matrix[, common_cells, drop = FALSE]
cell_metadata <- cell_metadata[common_cells, , drop = FALSE]
} else stop("Invalid input")
# ==== Basic checks ====
if (!cell_type_column %in% colnames(cell_metadata)) stop("Missing cell type column")
if (!is.null(expr_var) && expr_var < 0) stop("'expr_var' must be non-negative")
if (length(add_perc_background) == 1) {
bg_percents <- rep(add_perc_background, n_bulk_samples)
} else if (length(add_perc_background) == 2) {
bg_percents <- runif(n_bulk_samples, min = add_perc_background[1], max = add_perc_background[2])
} else stop("'add_perc_background' must be length 1 or 2")
# ==== Setup =====
cell_types <- as.character(cell_metadata[[cell_type_column]])
names(cell_types) <- colnames(count_matrix)
if (!is.null(select_ct)) {
main_pool_idx <- which(cell_types %in% select_ct)
bg_pool_idx   <- setdiff(seq_along(cell_types), main_pool_idx)
if (!length(main_pool_idx)) stop("No cells found for given select_ct")
} else {
main_pool_idx <- seq_along(cell_types)
bg_pool_idx   <- integer(0)
}
patient_mode <- !is.null(patient_id_column)
if (patient_mode) {
if (!patient_id_column %in% colnames(cell_metadata)) stop("Missing patient ID column")
patient_ids <- as.character(cell_metadata[[patient_id_column]])
}
# ==== Sampling ====
if (patient_mode) {
patient_levels <- unique(patient_ids)
main_by_patient <- split(main_pool_idx, patient_ids[main_pool_idx])
bg_by_patient   <- split(bg_pool_idx,   patient_ids[bg_pool_idx])
chosen_patients <- sample(patient_levels, n_bulk_samples, replace = TRUE)
sampled_ids <- lapply(seq_len(n_bulk_samples), function(i) {
set.seed(seet + i)
pat <- chosen_patients[i]
main_ids <- main_by_patient[[pat]]
if (is.null(main_ids) || length(main_ids) == 0) stop("No main pool cells for patient ", pat)
bg_ids   <- bg_by_patient[[pat]]
n_bg     <- if (length(bg_ids)) round(bg_percents[i] * cells_per_bulk) else 0
n_main   <- cells_per_bulk - n_bg
c(
sample(main_ids, n_main, replace = TRUE),
if (n_bg > 0) sample(bg_ids, n_bg, replace = TRUE)
)
})
} else {
n_bg_vec   <- if (length(bg_pool_idx)) round(bg_percents * cells_per_bulk) else integer(n_bulk_samples)
n_main_vec <- cells_per_bulk - n_bg_vec
sampled_ids <- mapply(
function(nm, nb) c(sample(main_pool_idx, nm, replace = TRUE),
if (nb > 0) sample(bg_pool_idx, nb, replace = TRUE) else integer(0)),
nm = n_main_vec, nb = n_bg_vec, SIMPLIFY = FALSE
)
}
if (return_used_samples) names(sampled_ids) <- paste0("sample_", seq_len(n_bulk_samples))
# ==== Common variables for aggregation ====
all_ids <- unlist(sampled_ids, use.names = FALSE)
grp <- rep(seq_len(n_bulk_samples), each = cells_per_bulk)
# ==== Aggregation handling ====
if (aggregation %in% c("average", "sum")) {
weight <- switch(aggregation,
"average" = 1 / cells_per_bulk,
"sum" = 1)
x_vals <- rep(weight, length(all_ids))
if (!is.null(expr_var)) x_vals <- x_vals * abs(rnorm(length(all_ids), mean = 1, sd = expr_var))
S <- Matrix::sparseMatrix(i = all_ids, j = grp, x = x_vals,
dims = c(ncol(count_matrix), n_bulk_samples))
bulk_expression <- as.matrix(count_matrix %*% S)
} else if (aggregation == "both") {
# average
x_vals_avg <- rep(1 / cells_per_bulk, length(all_ids))
# sum
x_vals_sum <- rep(1, length(all_ids))
if (!is.null(expr_var)) {
rand_factor <- abs(rnorm(length(all_ids), mean = 1, sd = expr_var))
x_vals_avg <- x_vals_avg * rand_factor
x_vals_sum <- x_vals_sum * rand_factor
}
S_avg <- Matrix::sparseMatrix(i = all_ids, j = grp, x = x_vals_avg,
dims = c(ncol(count_matrix), n_bulk_samples))
S_sum <- Matrix::sparseMatrix(i = all_ids, j = grp, x = x_vals_sum,
dims = c(ncol(count_matrix), n_bulk_samples))
bulk_expression_average <- as.matrix(count_matrix %*% S_avg)
bulk_expression_sum <- as.matrix(count_matrix %*% S_sum)
}
# ==== Ground truth proportions ====
unique_ct <- unique(cell_types)
ct_idx <- match(cell_types, unique_ct)
Cmat <- Matrix::sparseMatrix(i = ct_idx,
j = seq_along(ct_idx),
x = 1,
dims = c(length(unique_ct), length(ct_idx)))
ground_truth_proportions <- t(as.matrix(Cmat %*% Matrix::sparseMatrix(
i = all_ids,
j = grp,
x = 1 / cells_per_bulk,
dims = c(length(ct_idx), n_bulk_samples)
)))
colnames(ground_truth_proportions) <- unique_ct
rownames(ground_truth_proportions) <- paste0("sample_", seq_len(n_bulk_samples))
# ==== Assemble results ====
result <- list(
ground_truth_proportions = ground_truth_proportions,
parameters = list(
n_bulk_samples = n_bulk_samples,
cells_per_bulk = cells_per_bulk,
aggregation = aggregation,
select_ct = select_ct,
add_perc_background = add_perc_background,
actual_bg_percents = bg_percents,
patient_mode = patient_mode
)
)
if (aggregation == "average" || aggregation == "sum") {
result$bulk_expression_profiles <- bulk_expression
} else if (aggregation == "both") {
result$bulk_expression_profiles_average <- bulk_expression_average
result$bulk_expression_profiles_sum <- bulk_expression_sum
}
if (return_used_samples) result$used_samples <- sampled_ids
if (patient_mode && return_patient_metadata) {
result$bulk_patient_metadata <- data.frame(
sample_id = paste0("sample_", seq_len(n_bulk_samples)),
patient_id = chosen_patients
)
}
if (verbose) {
cat(sprintf("Generated %d bulks (%d cells each) from %d genes [patient_mode=%s || mode=%s]\n",
n_bulk_samples, cells_per_bulk, nrow(count_matrix),patient_mode, aggregation))
}
return(result)
}
